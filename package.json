{
  "name": "pagebrief",
  "version": "0.3.0",
  "description": "An MCP server that gives AI agents any web page as compact typed text over raw Chrome DevTools Protocol, with page maps for repeat visits and a reproducible benchmark",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "browser",
    "ai-agents",
    "chrome-devtools-protocol",
    "cdp",
    "web-scraping",
    "llm",
    "claude"
  ],
  "homepage": "https://github.com/govindplal/pagebrief#readme",
  "bugs": {
    "url": "https://github.com/govindplal/pagebrief/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/govindplal/pagebrief.git"
  },
  "license": "Apache-2.0",
  "author": "Govind P Lal",
  "type": "module",
  "bin": {
    "pagebrief": "bin/pagebrief.js"
  },
  "files": [
    "bin",
    "src",
    "!src/**/*.test.ts",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "tsx src/cli.ts mcp",
    "open": "tsx src/cli.ts open",
    "test": "node --import tsx --test \"bench/**/*.test.ts\" \"src/**/*.test.ts\"",
    "lint": "tsc --noEmit",
    "bench": "tsx bench/src/run.ts",
    "bench:report": "tsx bench/src/report.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "tsx": "4.23.15",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/mcp": "0.0.84",
    "@types/node": "24.19.2",
    "agent-browser": "0.41.2",
    "typescript": "6.0.2"
  }
}
